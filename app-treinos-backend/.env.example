# Copie para .env (nunca commite o .env)

# String de conexao do Neon (projeto app-treinos). Em Lambda, use o endpoint "pooled" (host com -pooler).
DATABASE_URL=postgresql://usuario:senha@host/neondb?sslmode=require

# Segredo para assinar o JWT (minimo 32 caracteres). Gere com: python scripts/gerar_credenciais.py
# Use um valor DIFERENTE do app financeiro.
JWT_SECRET_KEY=

# Hash bcrypt da senha de acesso. Gere com: python scripts/gerar_credenciais.py
# Use aspas simples, pois o hash contem "$".
APP_PASSWORD_HASH=''

# Origens permitidas no CORS, separadas por virgula (sem barra final)
ALLOWED_ORIGINS=http://localhost:5173
